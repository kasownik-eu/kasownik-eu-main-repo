{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "verifiedAt": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "enum": [
              "operator",
              "tickets",
              "purchase",
              "zones"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "xpath": {
            "type": [
              "string",
              "null"
            ]
          },
          "quote": {
            "type": "string",
            "minLength": 3
          }
        },
        "required": [
          "file",
          "path",
          "value",
          "url",
          "quote"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "verifiedAt",
    "facts"
  ],
  "additionalProperties": false
}
