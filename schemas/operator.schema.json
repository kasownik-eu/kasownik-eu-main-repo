{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "shortName": {
      "type": [
        "string",
        "null"
      ]
    },
    "sampleData": {
      "type": "boolean"
    },
    "label": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "pl": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "pl"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "logo": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "pattern": "^[\\w.-]+$"
            },
            "alt": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "pl": {
                      "type": "string",
                      "minLength": 1
                    },
                    "en": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "pl"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "file"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "description": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "pl": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "pl"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "websiteUrl": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "timetableUrl": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "transportModes": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "tram",
              "bus",
              "metro",
              "train",
              "trolleybus",
              "ferry"
            ]
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "zoneCount": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "currency": {
      "type": [
        "string",
        "null"
      ]
    },
    "paymentInfo": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "pl": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "pl"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "hotline": {
      "type": [
        "string",
        "null"
      ]
    },
    "servicePoint": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "pl": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "pl"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "verifiedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "related": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "operator": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "relation": {
                "type": "string",
                "enum": [
                  "neighbourCity",
                  "sharedArea",
                  "regional",
                  "private"
                ]
              },
              "ticketValidity": {
                "type": "string",
                "enum": [
                  "valid",
                  "partial",
                  "invalid"
                ]
              },
              "note": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "pl": {
                        "type": "string",
                        "minLength": 1
                      },
                      "en": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "pl"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "coverage": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "pl": {
                        "type": "string",
                        "minLength": 1
                      },
                      "en": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "pl"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "operator",
              "relation",
              "ticketValidity"
            ],
            "additionalProperties": false
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "sources": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "items": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "object",
                        "properties": {
                          "pl": {
                            "type": "string",
                            "minLength": 1
                          },
                          "en": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "pl"
                        ],
                        "additionalProperties": false
                      },
                      "url": {
                        "anyOf": [
                          {
                            "type": "string",
                            "format": "uri"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "label"
                    ],
                    "additionalProperties": false
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "aiAssisted": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "tariffSources": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "xpath": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "url"
            ],
            "additionalProperties": false
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": false
}
