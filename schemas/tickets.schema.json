{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tickets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "single",
              "short",
              "long",
              "other"
            ]
          },
          "name": {
            "type": "object",
            "properties": {
              "pl": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "pl"
            ],
            "additionalProperties": false
          },
          "validity": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "pl": {
                    "type": "string",
                    "minLength": 1
                  },
                  "en": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "pl"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "scope": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "pl": {
                    "type": "string",
                    "minLength": 1
                  },
                  "en": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "pl"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "transportModes": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "tram",
                    "bus",
                    "metro",
                    "train",
                    "trolleybus",
                    "ferry"
                  ]
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "priceNormal": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "priceReduced": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "whereToBuy": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "pl": {
                    "type": "string",
                    "minLength": 1
                  },
                  "en": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "pl"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "media": {
            "anyOf": [
              {
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "paper",
                    "app",
                    "paymentCard",
                    "cityCard"
                  ]
                }
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "category",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "media": {
      "anyOf": [
        {
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "paper",
                  "app",
                  "paymentCard",
                  "cityCard"
                ]
              },
              "name": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "pl": {
                        "type": "string",
                        "minLength": 1
                      },
                      "en": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "pl"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "action": {
                "type": "object",
                "properties": {
                  "pl": {
                    "type": "string",
                    "minLength": 1
                  },
                  "en": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "pl"
                ],
                "additionalProperties": false
              },
              "when": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "pl": {
                        "type": "string",
                        "minLength": 1
                      },
                      "en": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "pl"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "steps": {
                "anyOf": [
                  {
                    "maxItems": 6,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "pl": {
                          "type": "string",
                          "minLength": 1
                        },
                        "en": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "pl"
                      ],
                      "additionalProperties": false
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "photo": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "image": {
                        "type": "object",
                        "properties": {
                          "file": {
                            "type": "string",
                            "pattern": "^[\\w.-]+$"
                          },
                          "alt": {
                            "anyOf": [
                              {
                                "type": "object",
                                "properties": {
                                  "pl": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "en": {
                                    "type": "string",
                                    "minLength": 1
                                  }
                                },
                                "required": [
                                  "pl"
                                ],
                                "additionalProperties": false
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": [
                          "file"
                        ],
                        "additionalProperties": false
                      },
                      "caption": {
                        "type": "object",
                        "properties": {
                          "pl": {
                            "type": "string",
                            "minLength": 1
                          },
                          "en": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "pl"
                        ],
                        "additionalProperties": false
                      },
                      "alt": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "pl": {
                                "type": "string",
                                "minLength": 1
                              },
                              "en": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "required": [
                              "pl"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "image",
                      "caption"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "type",
              "action"
            ],
            "additionalProperties": false
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "luggage": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "luggage",
                      "bike",
                      "pet",
                      "stroller",
                      "other"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "item": {
                "type": "object",
                "properties": {
                  "pl": {
                    "type": "string",
                    "minLength": 1
                  },
                  "en": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "pl"
                ],
                "additionalProperties": false
              },
              "note": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "pl": {
                        "type": "string",
                        "minLength": 1
                      },
                      "en": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "pl"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "transportModes": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "tram",
                        "bus",
                        "metro",
                        "train",
                        "trolleybus",
                        "ferry"
                      ]
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "fee": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "feeText": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "pl": {
                        "type": "string",
                        "minLength": 1
                      },
                      "en": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "pl"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "conditions": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "pl": {
                        "type": "string",
                        "minLength": 1
                      },
                      "en": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "pl"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "whereToBuy": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "pl": {
                        "type": "string",
                        "minLength": 1
                      },
                      "en": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "pl"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "item"
            ],
            "additionalProperties": false
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "rulesNote": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "pl": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "pl"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "rulesUrl": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "tickets"
  ],
  "additionalProperties": false
}
