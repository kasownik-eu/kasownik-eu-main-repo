                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "pl": {
                        "type": "string",
                        "minLength": 1
                      },
                      "en": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "pl"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
