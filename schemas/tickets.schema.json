                    "tram",
                    "bus",
                    "metro",
                    "train",
                    "trolleybus",
                    "ferry"
                  ]
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "priceNormal": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
