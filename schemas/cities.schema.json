{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "slug": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "name": {
        "type": "object",
        "properties": {
          "pl": {
            "type": "string",
            "minLength": 1
          },
          "en": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "pl"
        ],
        "additionalProperties": false
      },
      "voivodeship": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "primary": {
        "type": "boolean"
      }
    },
    "required": [
      "slug",
      "name"
    ],
    "additionalProperties": false
  }
}
