{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "name": {
      "type": "object",
      "properties": {
        "pl": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "pl"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "code",
    "name"
  ],
  "additionalProperties": false
}
