        },
        {
          "pl": "Aktywuj bilet przed wejściem. Czas liczy się od aktywacji.",
          "en": "Activate before boarding. Time counts from activation."
        },
        {
          "pl": "Miej naładowany telefon pod ręką do końca jazdy.",
          "en": "Keep a charged phone at hand until the end of the ride."
        }
      ]
    },
