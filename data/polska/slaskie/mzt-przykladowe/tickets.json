        "pl": "Przy każdym wejściu do pojazdu",
        "en": "Every time you board"
      },
      "steps": [
        {
          "pl": "Przy wejściu zbliż kartę lub telefon do czytnika z ikoną fal.",
          "en": "On boarding, tap your card or phone on the reader with the wave icon."
        },
        {
          "pl": "Poczekaj na zielone światło i krótki sygnał.",
          "en": "Wait for the green light and a short beep."
        },
        {
          "pl": "Opłata pobierze się sama. To zakup i skasowanie naraz.",
          "en": "You are charged automatically: buying and validating at once."
        },
        {
          "pl": "Przy kontroli przyłóż tę samą kartę lub telefon.",
          "en": "At a ticket check, tap the same card or phone."
        }
      ]
    },
