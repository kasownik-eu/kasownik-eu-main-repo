      "action": {
        "pl": "Skasuj w kasowniku",
        "en": "Validate in the validator"
      },
      "when": {
        "pl": "Zaraz po wejściu do pojazdu",
        "en": "Right after boarding"
      },
      "steps": [
        {
          "pl": "Wejdź do pojazdu i znajdź kasownik przy najbliższych drzwiach.",
          "en": "Board and find the validator by the nearest door."
        },
        {
          "pl": "Włóż bilet do szczeliny strzałką w dół, napisem do siebie.",
          "en": "Insert the ticket arrow down, text facing you."
        },
        {
          "pl": "Poczekaj na sygnał. Kasownik wydrukuje datę i godzinę.",
          "en": "Wait for the beep. The validator prints the date and time."
        },
        {
          "pl": "Sprawdź nadruk i zachowaj bilet do końca jazdy.",
          "en": "Check the print and keep the ticket until the end of the ride."
        }
      ]
    },
    {
      "type": "app",
      "action": {
        "pl": "Aktywuj przed wejściem",
        "en": "Activate before boarding"
      },
      "when": {
        "pl": "Na przystanku, zanim wejdziesz",
        "en": "At the stop, before you board"
      },
      "steps": [
        {
