DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/kasownik
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Extra hosts allowed to load JS from `next dev` (comma-separated, wildcards ok).
# Private LAN IPs and *.local are already allowed, so a phone on your Wi-Fi works.
# ALLOWED_DEV_ORIGINS=my-tunnel.ngrok-free.app

# Tariff sync
# fixture | ollama-cloud
TARIFF_LLM_PROVIDER=fixture
TARIFF_LLM_FIXTURE_DIR=tests/fixtures/tariffs

# Ollama Cloud (TARIFF_LLM_PROVIDER=ollama-cloud). Key: https://ollama.com/settings/keys
OLLAMA_API_KEY=
# Optional overrides, defaults in src/tariffs/llm/ollama-cloud/config.ts
# OLLAMA_MODEL=gpt-oss:120b
# OLLAMA_BASE_URL=https://ollama.com
# OLLAMA_THINK=low
# OLLAMA_TEMPERATURE=0
# OLLAMA_SEED=42
# OLLAMA_NUM_CTX=32768
# OLLAMA_NUM_PREDICT=8192
# OLLAMA_TIMEOUT_MS=180000
# OLLAMA_MAX_RETRIES=2
# OLLAMA_RETRY_DELAY_MS=2000
TARIFF_CACHE_DIR=.tmp/tariffs
# Comma-separated recipients of tariff sync failure / review emails
TARIFF_NOTIFY_EMAILS=
# Used for admin links in emails
SERVER_URL=http://localhost:3000

# Email (SMTP). Without SMTP_HOST emails are logged to the console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=noreply@transport-helper.local
EMAIL_FROM_NAME='Transport Helper'
