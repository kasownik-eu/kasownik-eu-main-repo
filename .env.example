# Content folder read by the build and the tariff sync, default data/
# CONTENT_DIR=data

# Extra hosts allowed to load JS from `next dev` (comma-separated, wildcards ok).
# Private LAN IPs and *.local are already allowed, so a phone on your Wi-Fi works.
# ALLOWED_DEV_ORIGINS=my-tunnel.ngrok-free.app

# Tariff sync
# fixture | ollama-cloud | ollama-local
TARIFF_LLM_PROVIDER=fixture
TARIFF_LLM_FIXTURE_DIR=tests/fixtures/tariffs

# Ollama Cloud (TARIFF_LLM_PROVIDER=ollama-cloud). Key: https://ollama.com/settings/keys
OLLAMA_API_KEY=
# Optional overrides, defaults in src/tariffs/llm/ollama-cloud/config.ts
# OLLAMA_MODEL=gpt-oss:120b
# OLLAMA_BASE_URL=https://ollama.com
# OLLAMA_THINK=low
# OLLAMA_TEMPERATURE=0
# OLLAMA_SEED=42
# OLLAMA_NUM_CTX=32768
# OLLAMA_NUM_PREDICT=8192
# OLLAMA_TIMEOUT_MS=180000
# OLLAMA_MAX_RETRIES=2
# OLLAMA_RETRY_DELAY_MS=2000
# Local Ollama (TARIFF_LLM_PROVIDER=ollama-local). Needs `ollama serve` and a pulled model (`ollama pull <model>`)
# OLLAMA_LOCAL_MODEL=qwen3:8b
# Optional overrides, defaults in src/tariffs/llm/ollama-local/config.ts
# OLLAMA_LOCAL_BASE_URL=http://localhost:11434
# OLLAMA_LOCAL_THINK=false
# OLLAMA_LOCAL_TEMPERATURE=0
# OLLAMA_LOCAL_SEED=42
# OLLAMA_LOCAL_NUM_CTX=16384
# OLLAMA_LOCAL_NUM_PREDICT=8192
# OLLAMA_LOCAL_TIMEOUT_MS=600000
# OLLAMA_LOCAL_MAX_RETRIES=1
# OLLAMA_LOCAL_RETRY_DELAY_MS=2000
TARIFF_CACHE_DIR=.tmp/tariffs
