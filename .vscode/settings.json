{
  "npm.packageManager": "pnpm",
  // Autocomplete and validation for the content files (generated by `npm run generate:schemas`)
  "json.schemas": [
    { "fileMatch": ["data/*/country.json"], "url": "./schemas/country.schema.json" },
    { "fileMatch": ["data/*/*/voivodeship.json"], "url": "./schemas/voivodeship.schema.json" },
    { "fileMatch": ["data/*/*/*/operator.json"], "url": "./schemas/operator.schema.json" },
    { "fileMatch": ["data/*/*/*/cities.json"], "url": "./schemas/cities.schema.json" },
    { "fileMatch": ["data/*/*/*/purchase.json"], "url": "./schemas/purchase.schema.json" },
    { "fileMatch": ["data/*/*/*/tickets.json"], "url": "./schemas/tickets.schema.json" },
    { "fileMatch": ["data/*/*/*/zones.json"], "url": "./schemas/zones.schema.json" },
    { "fileMatch": ["templates/*/*.json"], "url": "./schemas/template.schema.json" }
  ],
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "editor.formatOnSaveMode": "file",
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "[javascript][typescript][typescriptreact]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  }
}
