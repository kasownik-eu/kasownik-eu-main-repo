{
  "name": "kasownik.eu-mian-app",
  "version": "1.0.0",
  "description": "Kasownik.eu: public transport ticket guide, static site built from JSON files",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "tsx src/scripts/copyImages.ts",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "prebuild": "tsx src/scripts/copyImages.ts",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "validate:data": "tsx src/scripts/validateData.ts",
    "sync:tariffs": "tsx src/scripts/syncTariffs.ts",
    "generate:schemas": "tsx src/scripts/generateSchemas.ts",
    "research:context": "tsx src/scripts/researchContext.ts",
    "research:check-source": "tsx src/scripts/researchCheckSource.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "jsdom": "^28.0.0",
    "lucide-react": "^1.63.0",
    "minisearch": "^7.2.0",
    "next": "16.3.3",
    "next-intl": "^4.14.9",
    "ollama": "^0.6.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "16.3.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "postcss": "^8.5.32",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
